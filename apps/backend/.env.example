# Copy to .env and fill in. Never commit the real .env.

PORT=8081

# Comma-separated list of Google account emails allowed to sign in.
ALLOWED_EMAILS=you@example.com,friend@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bradjobe.dev/ccaas/auth/google/callback

# Long random string (e.g. `openssl rand -hex 32`). Rotating it logs everyone out.
SESSION_SECRET=

# Where the frontend lives from the browser's perspective, used for post-login redirects.
PUBLIC_BASE_PATH=/ccaas

# SQLite file, Squid ACL directory shared with the egress-proxy container (bind mount).
DATA_DIR=/srv/ccaas/data
SQUID_ACL_DIR=/srv/ccaas/squid-acl

# Resource guardrails for the small server.
MAX_CONCURRENT_CONTAINERS=2
IDLE_TIMEOUT_MINUTES=20
